# Intermediates from the CE toolchain. The finished program in calc/bin is
# committed on purpose, so it can be installed without building anything.
calc/obj/
*.o
*.bc

# Built by tools/build.sh -- platform-specific, rebuild it locally.
tools/vendor/zx0/libzx0.so
tools/vendor/zx0/libzx0.dylib
tools/vendor/zx0/zx0.dll

# Built by tools/hosttest/build.sh
tools/hosttest/render_probe
tools/hosttest/lib_probe
tools/hosttest/ui_probe
tools/hosttest/usb_probe

# Generated from about.txt on every build by tools/make_about.sh.
calc/src/about.h

__pycache__/
*.pyc

# Converter output: comics, not source.
out/
*.8xv

about.txt
